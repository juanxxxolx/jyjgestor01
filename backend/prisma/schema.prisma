generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id_usuario     Int          @id @default(autoincrement())
  nombre         String       @db.VarChar(100)
  email          String       @unique @db.VarChar(255)
  password_hash  String       @db.Text
  id_rol         Int          @default(2)
  activo         Boolean      @default(true)
  fecha_creacion DateTime     @default(now())
  clientes       Cliente[]
  movimientos    Movimiento[]
  ventas         Venta[]
  cotizaciones   Cotizacion[]
  compras        Compra[]
  cierres        CierreCaja[]

  @@map("usuarios")
}

model Cliente {
  id_cliente     Int          @id @default(autoincrement())
  nombre         String       @db.VarChar(200)
  email          String?      @db.VarChar(255)
  telefono       String?      @db.VarChar(20)
  direccion      String?      @db.VarChar(300)
  tipo_cliente   String?      @db.VarChar(20)
  fecha_registro DateTime     @default(now())
  ultimo_pedido  DateTime?
  id_usuario     Int?
  usuario        Usuario?     @relation(fields: [id_usuario], references: [id_usuario])
  movimientos    Movimiento[]
  ventas         Venta[]
  cotizaciones   Cotizacion[]
  abonos         Abono[]
  saldo          Decimal           @default(0) @db.Decimal(12, 2)

  @@map("clientes")
}

model Proveedor {
  id_proveedor Int       @id @default(autoincrement())
  nombre       String    @db.VarChar(200)
  contacto     String?   @db.VarChar(100)
  telefono     String?   @db.VarChar(20)
  email        String?   @db.VarChar(255)
  direccion    String?   @db.VarChar(300)
  created_at   DateTime  @default(now())
  productos    Producto[]
  compras      Compra[]

  @@map("proveedores")
}

model Categoria {
  id_categoria     Int        @id @default(autoincrement())
  nombre_categoria String     @db.VarChar(100)
  productos        Producto[]

  @@map("categorias")
}

model Producto {
  id_producto       Int               @id @default(autoincrement())
  nombre            String            @db.VarChar(100)
  referencia        String            @unique @db.VarChar(50)
  descripcion       String?           @db.Text
  imagen_url        String?           @db.VarChar(500)
  precio_venta      Decimal           @db.Decimal(10, 2)
  stock             Int               @default(0)
  stock_minimo      Int               @default(5)
  id_categoria      Int?
  id_proveedor      Int?
  categoria         Categoria?        @relation(fields: [id_categoria], references: [id_categoria])
  proveedor         Proveedor?        @relation(fields: [id_proveedor], references: [id_proveedor])
  movimientos       Movimiento[]
  precios_historicos PrecioHistorico[]
  detalle_ventas     DetalleVenta[]
  detalle_cotizaciones DetalleCotizacion[]
  detalle_compras    DetalleCompra[]

  @@map("productos")
}

model PrecioHistorico {
  id_historico   Int      @id @default(autoincrement())
  id_producto    Int
  precio_anterior Decimal @db.Decimal(10, 2)
  precio_nuevo   Decimal  @db.Decimal(10, 2)
  fecha_cambio   DateTime @default(now())
  id_usuario     Int?
  producto       Producto @relation(fields: [id_producto], references: [id_producto])

  @@map("precios_historicos")
}

model AuditLog {
  id             Int      @id @default(autoincrement())
  id_usuario     Int?
  usuario_nombre String   @db.VarChar(200)
  accion         String   @db.VarChar(255)
  entidad        String   @db.VarChar(100)
  id_entidad     Int?
  detalle        String?  @db.Text
  ip             String?  @db.VarChar(50)
  created_at     DateTime @default(now())

  @@map("audit_logs")
}

model PasswordResetToken {
  id         Int      @id @default(autoincrement())
  email      String   @db.VarChar(255)
  token      String   @unique @db.VarChar(500)
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  @@map("password_reset_tokens")
}

model Venta {
  id_venta    Int           @id @default(autoincrement())
  id_usuario  Int
  id_cliente  Int?
  total       Decimal       @db.Decimal(12, 2)
  estado      String        @default("COMPLETADA") @db.VarChar(20)
  metodo_pago String        @default("EFECTIVO") @db.VarChar(20)
  created_at  DateTime      @default(now())
  usuario     Usuario       @relation(fields: [id_usuario], references: [id_usuario])
  cliente     Cliente?      @relation(fields: [id_cliente], references: [id_cliente])
  detalle     DetalleVenta[]

  @@map("ventas")
}

model DetalleVenta {
  id_detalle      Int     @id @default(autoincrement())
  id_venta        Int
  id_producto     Int
  cantidad        Int
  precio_unitario Decimal @db.Decimal(10, 2)
  subtotal        Decimal @db.Decimal(12, 2)
  venta           Venta   @relation(fields: [id_venta], references: [id_venta])
  producto        Producto @relation(fields: [id_producto], references: [id_producto])

  @@map("detalle_ventas")
}

model Cotizacion {
  id_cotizacion Int               @id @default(autoincrement())
  id_usuario    Int
  id_cliente    Int?
  total         Decimal           @db.Decimal(12, 2)
  estado        String            @default("PENDIENTE") @db.VarChar(20)
  created_at    DateTime          @default(now())
  usuario       Usuario           @relation(fields: [id_usuario], references: [id_usuario])
  cliente       Cliente?          @relation(fields: [id_cliente], references: [id_cliente])
  detalle       DetalleCotizacion[]

  @@map("cotizaciones")
}

model DetalleCotizacion {
  id_detalle      Int       @id @default(autoincrement())
  id_cotizacion   Int
  id_producto     Int
  cantidad        Int
  precio_unitario Decimal   @db.Decimal(10, 2)
  subtotal        Decimal   @db.Decimal(12, 2)
  cotizacion      Cotizacion @relation(fields: [id_cotizacion], references: [id_cotizacion])
  producto        Producto  @relation(fields: [id_producto], references: [id_producto])

  @@map("detalle_cotizaciones")
}

model Compra {
  id_compra   Int             @id @default(autoincrement())
  id_usuario  Int
  id_proveedor Int?
  total       Decimal         @db.Decimal(12, 2)
  created_at  DateTime        @default(now())
  usuario     Usuario         @relation(fields: [id_usuario], references: [id_usuario])
  proveedor   Proveedor?      @relation(fields: [id_proveedor], references: [id_proveedor])
  detalle     DetalleCompra[]

  @@map("compras")
}

model DetalleCompra {
  id_detalle   Int     @id @default(autoincrement())
  id_compra    Int
  id_producto  Int
  cantidad     Int
  costo_unitario Decimal @db.Decimal(10, 2)
  subtotal     Decimal @db.Decimal(12, 2)
  compra       Compra  @relation(fields: [id_compra], references: [id_compra])
  producto     Producto @relation(fields: [id_producto], references: [id_producto])

  @@map("detalle_compras")
}

model Abono {
  id_abono    Int      @id @default(autoincrement())
  id_cliente  Int
  monto       Decimal  @db.Decimal(12, 2)
  created_at  DateTime @default(now())
  cliente     Cliente  @relation(fields: [id_cliente], references: [id_cliente])

  @@map("abonos")
}

model CierreCaja {
  id_cierre    Int      @id @default(autoincrement())
  id_usuario   Int
  total_ventas Decimal  @db.Decimal(12, 2)
  efectivo_declarado Decimal @db.Decimal(12, 2)
  diferencia   Decimal  @db.Decimal(12, 2)
  observacion  String?  @db.VarChar(300)
  created_at   DateTime @default(now())
  usuario      Usuario  @relation(fields: [id_usuario], references: [id_usuario])

  @@map("cierres_caja")
}

model Movimiento {
  id_movimiento    Int      @id @default(autoincrement())
  id_producto      Int
  tipo_movimiento  String   @db.VarChar(20)
  cantidad         Decimal  @db.Decimal(10, 2)
  motivo           String   @db.Text
  fecha_movimiento DateTime @default(now())
  id_usuario       Int?
  id_cliente       Int?
  producto         Producto @relation(fields: [id_producto], references: [id_producto])
  usuario          Usuario? @relation(fields: [id_usuario], references: [id_usuario])
  cliente          Cliente? @relation(fields: [id_cliente], references: [id_cliente])

  @@map("movimientos")
}
