# ========================================
# CONFIGURACIÓN DEL PROYECTO
# ========================================
# Renombra este archivo a .env y configura según tu entorno

# PUERTO DEL SERVIDOR
PORT=3000

# ENTORNO (development, production)
NODE_ENV=development

# ========== DATABASE ==========
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=gestor_inventario_db

# ========== SEGURIDAD ==========
# ⚠️ CRÍTICO: Cambia esta clave en producción a algo seguro y aleatorio
JWT_SECRET=cambia_esta_clave_super_segura_en_produccion_min_32_caracteres_aleatorios_12345
JWT_EXPIRE=7d

# ========== FRONTEND ==========
FRONTEND_URL=http://localhost:5173

# ========== CORREO (SMTP) - OPCIONAL ==========
# Necesario solo para enviar automáticamente los enlaces de recuperación.
# Ejemplo Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=tucorreo@gmail.com, SMTP_PASS=contraseña_de_aplicación
# Si quedan vacíos, el administrador genera el enlace desde Usuarios.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ========== LOGGING ==========
LOG_LEVEL=info
